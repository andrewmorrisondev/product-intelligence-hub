# Public demo works without any of these variables.
# For a private workspace, configure both DATABASE_URL and WORKSPACE_PASSWORD.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
WORKSPACE_PASSWORD="replace-with-a-long-random-password"

# The server syncs ONLY this configured GitHub repository.
GITHUB_OWNER="morrison-developers"
GITHUB_REPO="YOUR_REPO"
GITHUB_TOKEN="" # Optional for public repositories; required for private ones

# Optional: changes classification from deterministic baseline to LLM-based drafts.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
